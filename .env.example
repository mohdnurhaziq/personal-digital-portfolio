APP_NAME="Mohd. Nur Haziq Irsyamuddin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match how the site is actually served: Media Library builds absolute
# URLs from it, so a mismatched port gives a page of broken images.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL only — the same engine production runs, and the same database the
# Docker stack creates. DB_HOST is 127.0.0.1 for artisan commands run on the
# host against the published port; inside the container Compose overrides it
# with the `db` service name.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=secret
# The port the db container publishes on the host. 3307 rather than 3306,
# because a system MySQL commonly already holds 3306 — when it does, Docker
# binds IPv6 only and host-side connections silently reach the wrong server.
# Keep this and DB_PORT the same.
DB_PORT_HOST=3307

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Single admin account seeded by DatabaseSeeder (no public registration).
# The seeder skips creating the user unless ADMIN_PASSWORD is set.
ADMIN_NAME="Mohd. Nur Haziq Irsyamuddin"
ADMIN_EMAIL=hello@ziq.dev
ADMIN_PASSWORD=
